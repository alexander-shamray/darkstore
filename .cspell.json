{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaries": ["en_US", "companies", "softwareTerms", "dotnet", "csharp"],
  "dictionaryDefinitions": [],

  "files": [
    "src/**/*.cs",
    "tests/**/*.cs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.json",
    "**/*.sql"
  ],

  "ignorePaths": [
    "node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/*.min.js",
    "**/*.generated.cs",
    "coverage*/**",
    "publish/**",
    "site/**",
    ".git/**",
    "docs/Костанай.pdf"
  ],

  "ignoreRegExpList": [
    "\\b[0-9a-fA-F]{8,}\\b",
    "https?://[^\\s]+",
    "#[0-9a-fA-F]{3,8}\\b",
    "\\b[A-Z][A-Z0-9_]{3,}\\b"
  ],

  "words": [
    "darkstore",
    "DarkStore",
    "dotnet",
    "nullable",
    "readonly",
    "csproj",
    "slnx",
    "resx",
    "nuget",
    "testcontainers",
    "cobertura",
    "openapi",
    "swagger",
    "appsettings",
    "webapps",
    "azurewebsites",
    "healthcheck",
    "middleware",
    "interceptor",
    "idempotency",
    "webhook",
    "microservice",
    "monorepo",
    "frontend",
    "backend",
